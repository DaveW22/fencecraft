---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingContact from '../components/FloatingContact.astro';
interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  serviceName?: string;
  serviceArea?: string;
}
const isIndexableBuild = import.meta.env.PUBLIC_SITE_ENV === 'production';
const {
  title, description, canonical, noindex = !isIndexableBuild, serviceName, serviceArea,
} = Astro.props;
const canonicalUrl = canonical ? new URL(canonical, Astro.site) : Astro.url;
const businessId = new URL('/#business', Astro.site).href;
const coverage = ['Flintshire', 'Wrexham', 'Chester', 'Wirral'];
const business = {
  '@type': 'HomeAndConstructionBusiness',
  '@id': businessId,
  name: 'FenceCraft',
  url: Astro.site?.href,
  telephone: '+447935190681',
  email: 'info@fence-craft.co.uk',
  areaServed: coverage,
};
const graph = serviceName ? [business, {
  '@type': 'Service',
  '@id': new URL('#service', canonicalUrl).href,
  name: serviceName,
  url: canonicalUrl.href,
  description,
  provider: { '@id': businessId },
  areaServed: serviceArea ?? coverage,
}] : [business];
const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': graph,
}).replaceAll('<', '\\u003c');

---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow'} />
    <meta name="theme-color" content="#1f3529" />
    <link rel="icon" type="image/svg+xml" href="/assets/mark.svg" />
    <script type="application/ld+json" set:html={structuredData} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to main content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <FloatingContact />
  </body>
</html>
