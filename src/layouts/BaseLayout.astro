---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props { title: string; description: string; canonical?: string; noindex?: boolean; }
const { title, description, canonical, noindex = true } = Astro.props;
const canonicalUrl = canonical ? new URL(canonical, Astro.site) : Astro.url;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow'} />
    <meta name="theme-color" content="#1f3529" />
    <link rel="icon" type="image/svg+xml" href="/assets/mark.svg" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context':'https://schema.org', '@type':'HomeAndConstructionBusiness', name:'FenceCraft', url:'https://www.fence-craft.co.uk', telephone:'+447935190681', email:'info@fence-craft.co.uk', areaServed:['Flintshire','Wrexham','Chester','Wirral'], description
    })} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to main content</a>
    <div class="concept-bar">HERITAGE CRAFT · ILLUSTRATIVE PREVIEW <a href="/privacy/">Content and privacy note ↗</a></div>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <div class="mobile-cta" aria-label="Quick contact"><a class="btn outline" href="tel:+447935190681">Call FenceCraft</a><a class="btn" href="/request-a-quote/">Let’s talk ↗</a></div>
  </body>
</html>
