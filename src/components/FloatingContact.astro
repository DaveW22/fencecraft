<div class="floating-contact">
  <button class="floating-contact__toggle" type="button" aria-expanded="false" aria-controls="floating-contact-panel">
    <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="20" height="20"><path d="M6.6 3.5 9.1 3l2 4.7-1.8 1.7a14.7 14.7 0 0 0 5.3 5.3l1.7-1.8 4.7 2-.5 2.5a2 2 0 0 1-2.2 1.6A16.5 16.5 0 0 1 4.9 5.7 2 2 0 0 1 6.6 3.5Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" /></svg>
    <span>Contact us</span>
  </button>
  <div class="floating-contact__panel" id="floating-contact-panel" hidden>
    <button class="floating-contact__close" type="button" aria-label="Close contact options">×</button>
    <p class="eyebrow">LET’S TALK</p>
    <h2>How can we help?</h2>
    <a class="floating-contact__call" href="tel:+447935190681">Call now · 07935 190681</a>
    <a class="floating-contact__email" href="mailto:info@fence-craft.co.uk">Email us</a>
  </div>
</div>

<script>
  const launcher = document.querySelector<HTMLButtonElement>('.floating-contact__toggle');
  const panel = document.querySelector<HTMLElement>('#floating-contact-panel');
  const closeButton = document.querySelector<HTMLButtonElement>('.floating-contact__close');

  const closePanel = () => {
    if (!launcher || !panel) return;
    launcher.setAttribute('aria-expanded', 'false');
    panel.classList.remove('is-open');
    panel.hidden = true;
    launcher.focus();
  };

  launcher?.addEventListener('click', () => {
    if (!panel) return;
    const opening = launcher.getAttribute('aria-expanded') !== 'true';
    launcher.setAttribute('aria-expanded', String(opening));
    if (opening) {
      panel.hidden = false;
      requestAnimationFrame(() => panel.classList.add('is-open'));
      closeButton?.focus();
    } else {
      closePanel();
    }
  });

  closeButton?.addEventListener('click', closePanel);
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && launcher?.getAttribute('aria-expanded') === 'true') closePanel();
  });
</script>
