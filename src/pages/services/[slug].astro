---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { services } from '../../data/services';
export function getStaticPaths() { return services.map((service) => ({ params: { slug: service.slug }, props: { service } })); }
const { service } = Astro.props;
---
<BaseLayout title={`${service.title} | FenceCraft`} description={`${service.short} FenceCraft serves Flintshire, Wrexham, Chester and the Wirral.`}>
  <div class="wrap breadcrumbs"><a href="/services/">Services</a> / {service.title}</div>
  <section class="wrap page-title"><p class="eyebrow">FENCECRAFT SERVICES</p><h1>{service.title}.</h1><p class="intro">{service.intro}</p><div class="hero-actions"><a class="btn" href={`/request-a-quote/?service=${service.slug}`}>Request a free quote ↗</a><a class="text-link" href="/contact/">Call or email instead</a></div></section>
  <section class="section sage"><div class="wrap split"><div><p class="eyebrow">WHAT YOU CAN ASK FOR</p><h2>A clear scope starts with a useful conversation.</h2></div><div class="content-grid">{service.asks.map((item, index) => <article><h3>{item}</h3><p>{service.askDescriptions?.[index] ?? 'We can talk through the practical details and what would suit your space.'}</p></article>)}</div></div></section>
  <section class="section"><div class="wrap split"><div><p class="eyebrow">WHAT AFFECTS THE QUOTE</p><h2>The setting matters as much as the finish.</h2></div><div class="content-grid">{service.quote.map((item, index) => <article><h3>{item}</h3><p>{service.quoteDescriptions?.[index] ?? 'Sharing these details early helps make the scope and next step more useful.'}</p></article>)}</div></div></section>
  <section class="section white"><div class="wrap quote-layout"><div><p class="eyebrow">WHAT HAPPENS NEXT</p><h2>Start with the details you have.</h2><p class="muted">{service.next}</p><p class="muted">Quotations are free and no-obligation. We will explain if a visit is needed to understand the work properly.</p></div><div class="callout"><strong>Prefer to talk?</strong><p>Call <a href="tel:+447935190681">07935 190681</a> or email <a href="mailto:info@fence-craft.co.uk">info@fence-craft.co.uk</a>.</p></div></div></section>
  <section class="cta-band"><div class="wrap"><div><p class="eyebrow">READY WHEN YOU ARE</p><h2>Tell us what you have in mind.</h2></div><a class="btn gold" href={`/request-a-quote/?service=${service.slug}`}>Request a free quote ↗</a></div></section>
</BaseLayout>
