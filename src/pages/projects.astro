---
import BaseLayout from '../layouts/BaseLayout.astro';
import { approvedCaseStudies, caseStudyFields } from '../data/caseStudies';
---
<BaseLayout title="Projects | FenceCraft" description="Genuine FenceCraft photographs and approved case studies for gardens, homes and parks.">
  <section class="wrap page-title"><p class="eyebrow">OUR WORK</p><h1>Genuine work, shown properly.</h1><p class="intro">Approved garden and park case studies will appear here with the location, customer brief, work carried out and the relevant service.</p></section>
  <section class="section"><div class="wrap proof-grid"><figure class="project"><img src="/assets/garden-1200.webp" width="1800" height="1200" alt="Illustrative garden fencing concept" /><figcaption><span>Garden fencing direction</span><span class="tag">ILLUSTRATIVE</span></figcaption></figure><figure class="project secondary"><img src="/assets/patio-1200.webp" width="1800" height="1200" alt="Illustrative patio and decking concept" /><figcaption><span>Patio and decking direction</span><span class="tag">ILLUSTRATIVE</span></figcaption></figure></div><div class="wrap"><p class="evidence-note">The images above are illustrative concepts, not completed FenceCraft projects. No customer, location, outcome or endorsement is implied.</p></div></section>
  <section class="section sage"><div class="wrap"><div class="section-head"><div><p class="eyebrow">CASE STUDY LAYOUT</p><h2>Ready for approved project stories.</h2></div><p class="muted">No project details have been invented. These are the exact facts needed before a garden or park example can be published.</p></div>{approvedCaseStudies.length ? <div class="content-grid">{approvedCaseStudies.map((study) => <article><p class="eyebrow">{study.audience === 'garden' ? 'GARDEN PROJECT' : 'PARK PROJECT'}</p><h3>{study.title}</h3><p>{study.service}</p><a class="text-link" href={`/services/${study.slug}/`}>View the service ↗</a></article>)}</div> : <div class="content-grid"><article><p class="eyebrow">GARDEN PROJECT</p><h3>Approved garden case study</h3><p>Awaiting a real location, customer brief, approved photograph and verified work summary.</p><a class="text-link" href="/services/garden-fencing/">Relevant service: garden fencing ↗</a></article><article><p class="eyebrow">PARK PROJECT</p><h3>Approved park case study</h3><p>Awaiting a real location, customer brief, approved photograph and verified work summary.</p><a class="text-link" href="/services/park-maintenance/">Relevant service: park maintenance ↗</a></article></div>}<ul class="case-study-fields">{caseStudyFields.map((field) => <li>{field}</li>)}</ul></div></section>
  <section class="cta-band"><div class="wrap"><div><p class="eyebrow">HAVE A PROJECT TO DISCUSS?</p><h2>Start with the practical details.</h2></div><a class="btn gold" href="/request-a-quote/">Request a free quote ↗</a></div></section>
</BaseLayout>
