---
import BaseLayout from '../layouts/BaseLayout.astro';

const workExamples = [
  {
    image: 'garden',
    alt: 'Illustrative garden with timber fencing and planting',
    title: 'Garden fencing and repairs',
    description: 'New timber boundaries, replacement panels and repairs to existing fences.',
    href: '/services/garden-fencing/',
  },
  {
    image: 'patio',
    alt: 'Illustrative garden with a paved patio and decking',
    title: 'Decking, patios and landscaping',
    description: 'Practical outdoor spaces for sitting, dining and making more of the garden.',
    href: '/for-your-home/',
  },
  {
    image: 'park',
    alt: 'Illustrative park home with decking and glass balustrades',
    title: 'Park homes and grounds',
    description: 'Decking, glass balustrades, exterior painting and grounds maintenance for parks.',
    href: '/for-parks/',
  },
];
---
<BaseLayout title="Our Work | FenceCraft" description="Explore the outdoor work FenceCraft takes on, from fencing, decking and paving for homes to grounds maintenance and improvements for caravan parks.">
  <section class="wrap page-title">
    <p class="eyebrow">OUR WORK</p>
    <h1>Outdoor work we take pride in.</h1>
    <p class="intro">We enjoy making outdoor spaces work better. That might mean repairing a fence that still has life in it, building a deck where you can sit out, or helping a park manager keep shared grounds tidy and usable.</p>
    <p>We start by asking how the space is used, what needs to change and what will be practical to look after. That gives us a useful starting point for discussing materials, access and the work itself.</p>
  </section>

  <section class="section sage">
    <div class="wrap">
      <h2>Types of work we carry out</h2>
      <p class="muted">The images below illustrate the types of work we offer.</p>
      <div class="work-examples">
        {workExamples.map(({ image, alt, title, description, href }) => (
          <figure class="project">
            <img
              src={`/assets/${image}-1200.webp`}
              srcset={`/assets/${image}-640.webp 640w, /assets/${image}-1200.webp 1200w`}
              sizes="(max-width: 700px) 100vw, 33vw"
              width="1200"
              height="800"
              loading="lazy"
              alt={alt}
            />
            <figcaption>
              <span class="tag">Illustrative image</span>
              <h3>{title}</h3>
              <p>{description}</p>
              <a class="text-link" href={href}>Explore {title.toLowerCase()} ↗</a>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="wrap">
      <div><p class="eyebrow">HAVE A PROJECT TO DISCUSS?</p><h2>Start with the practical details.</h2></div>
      <a class="btn gold" href="/request-a-quote/">Let’s talk ↗</a>
    </div>
  </section>
</BaseLayout>

<style>
  .work-examples {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-top: 30px;
  }

  .work-examples figure {
    margin: 0;
  }

  .work-examples figcaption {
    display: block;
  }

  .work-examples h3 {
    margin: 8px 0;
  }

  @media (max-width: 700px) {
    .work-examples {
      grid-template-columns: 1fr;
    }
  }
</style>
