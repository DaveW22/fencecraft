---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/services';
const homeServices = services.filter((s) => ['garden-fencing','glass-fencing','decking','landscaping','patio-paving','garden-brick-walls'].includes(s.slug));
---
<BaseLayout title="For Your Home | FenceCraft" description="Garden fencing, repairs, glass fencing, decking, landscaping, patio paving and garden brick walls for homes across Flintshire, Wrexham, Chester and the Wirral.">
  <section class="wrap page-title"><p class="eyebrow">FOR HOMEOWNERS</p><h1>Your home. Your garden.</h1><p class="intro">A little more privacy, a place to sit or a fresh start outside. Let’s make your garden work for you.</p><div class="hero-actions"><a class="btn" href="/request-a-quote/">Request a free quote ↗</a><a class="text-link" href="/services/">See all services ↗</a></div></section>
  <section class="section sage"><div class="wrap"><div class="section-head"><div><p class="eyebrow">OUTDOOR WORK WITH A PRACTICAL STARTING POINT</p><h2>Choose what you are thinking about.</h2></div><p class="muted">These are starting points, not a menu you need to fit into. If your project crosses over a few areas, tell us the whole picture.</p></div><div class="services-six">{homeServices.map((service) => <a href={`/services/${service.slug}/`}><h3>{service.title} ↗</h3><p>{service.short}</p></a>)}</div></div></section>
  <section class="section"><div class="wrap split"><img src="/assets/garden-1200.webp" width="1800" height="1200" loading="lazy" alt="Illustrative garden with a timber fence and planting" /><div><p class="eyebrow">A GOOD FIRST CONVERSATION</p><h2>We will talk through the practicalities.</h2><p class="muted">Access, ground conditions, materials and how you want to use the space all help shape a useful quote. You do not need to have every answer before getting in touch.</p><div class="owner-story">Over 40 years of practical experience, with friendly advice about what will work for your home.</div></div></div></section>
  <section class="cta-band"><div class="wrap"><div><p class="eyebrow">REQUEST A FREE QUOTE</p><h2>Tell us what you have in mind.</h2><p>Share a postcode and a few details. We will help make the next step clear.</p></div><a class="btn gold" href="/request-a-quote/">Request a free quote ↗</a></div></section>
</BaseLayout>
